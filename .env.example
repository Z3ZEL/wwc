# ---- Dev (docker compose). Copy to .env.
# Dev-only PocketBase superuser (admin dashboard at http://localhost:8090/_/)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=adminadmin123
# Confirmation emails go to mailpit: http://localhost:8025
PB_APP_URL=http://localhost:8090
PB_SMTP_ENABLED=true
PB_SMTP_HOST=mailpit
PB_SMTP_PORT=1025
PB_SENDER_ADDRESS=noreply@wwc.localhost

# ---- Production (README "Production", ADR 0012). Copy to .env.prod and uncomment.
# Non-secret settings (rate limits, logs, batch API, app name) live in backend/pb_settings.json;
# these env vars are applied after it. Unset variables leave the matching settings untouched.
#
# Frontend (build time, scripts/build-frontend.sh): public PocketBase URL, no trailing slash.
# WWC_API_URL=https://api.example.com
#
# Backend
# PB_ORIGINS=https://wwc.example.com            # CORS: frontend origin(s), comma-separated
# PB_APP_URL=https://api.example.com            # public PocketBase URL (links in emails)
# PB_APP_NAME=WWC                               # overrides pb_settings.json
# PB_SETTINGS_FILE=/etc/wwc/pb_settings.json    # mounted JSON merged over backend/pb_settings.json
# PB_ADMIN_EMAIL=                               # first boot only: creates the superuser,
# PB_ADMIN_PASSWORD=                            #   then remove both
# PB_TRUSTED_PROXY_HEADERS=X-Forwarded-For      # behind a load balancer / reverse proxy
#
# Uploaded files (photos) on S3; backups go to the same bucket unless PB_BACKUPS_S3_* is set.
# PB_S3_ENABLED=true
# PB_S3_BUCKET=wwc
# PB_S3_REGION=eu-west-1
# PB_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# PB_S3_ACCESS_KEY=
# PB_S3_SECRET=
# PB_S3_FORCE_PATH_STYLE=false                  # true for MinIO and most non-AWS providers
#
# Backups (pb_data snapshot as a zip)
# PB_BACKUPS_CRON=0 3 * * *                     # default when S3 is enabled
# PB_BACKUPS_MAX_KEEP=7
# PB_BACKUPS_S3_ENABLED=true                    # optional: a separate bucket, same variable
# PB_BACKUPS_S3_BUCKET=                         #   names as PB_S3_* (REGION, ENDPOINT, ...)
#
# SMTP (email confirmation, password reset)
# PB_SMTP_ENABLED=true
# PB_SMTP_HOST=smtp.example.com
# PB_SMTP_PORT=587
# PB_SMTP_USERNAME=
# PB_SMTP_PASSWORD=
# PB_SMTP_TLS=false                             # true = implicit TLS (port 465); 587 uses STARTTLS
# PB_SMTP_AUTH_METHOD=PLAIN                     # or LOGIN
# PB_SENDER_NAME=WWC
# PB_SENDER_ADDRESS=noreply@example.com
